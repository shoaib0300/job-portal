DATABASE_URL=mysql://db:db@db:3306/db
APP_ENV=prod
# Bright Data Web Unlocker (NOT the LinkedIn Marketplace dump):
# - LinkedIn guest HTML when the server IP is blocked
# - Indeed / StepStone / XING / Glassdoor Google site search
# - Some company career pages
BRIGHT_DATA_API_TOKEN=
BRIGHT_DATA_ZONE=web_unlocker1
# German PDF: DeepL Free/Pro if DEEPL_API_KEY is set (keys ending :fx use api-free.deepl.com).
# Otherwise local LibreTranslate (ddev restart). No LibreTranslate.com key needed.
DEEPL_API_KEY=
LIBRETRANSLATE_URL=http://libretranslate:5000
LIBRETRANSLATE_API_KEY=
