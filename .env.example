DATABASE_URL=mysql://db:db@db:3306/db
APP_ENV=prod
# Bright Data Web Unlocker: Indeed / StepStone / XING / Glassdoor Google site search + some career sites.
# LinkedIn does NOT need this — it uses php-jobspy / python-jobspy (see packages/php-jobspy, bin/jobspy_scrape.py).
BRIGHT_DATA_API_TOKEN=
BRIGHT_DATA_ZONE=web_unlocker1
# Optional override for LinkedIn JobSpy Python binary (default: python3 with jobspy installed).
# JOBSPY_PYTHON=/usr/bin/python3

# German PDF: DeepL Free/Pro if DEEPL_API_KEY is set (keys ending :fx use api-free.deepl.com).
# Otherwise local LibreTranslate (ddev restart). No LibreTranslate.com key needed.
DEEPL_API_KEY=
LIBRETRANSLATE_URL=http://libretranslate:5000
LIBRETRANSLATE_API_KEY=
